<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Screensaver: city-level location and local weather for the koi pond's sky -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 11 only reveals the Wi-Fi name to apps holding location; granted by install.sh -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Installing an update downloaded from GitHub Releases (Settings › Updates) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <queries>
        <!-- App-store pages, for "get Spotify" when it isn't installed -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="amzn" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@drawable/banner"
        android:banner="@drawable/banner"
        android:allowBackup="false"
        android:supportsRtl="false"
        android:theme="@style/Theme.Glass">

        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:resumeWhilePausing="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection">
            <intent-filter android:priority="1">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- A tile in Fire TV's Your Apps, so Glass can be opened (and pinned) from Amazon's home -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Koi pond screensaver: its own task, so closing it returns to whatever was on screen.
             Exported (it only shows the pond) so it can be started over ADB for testing. -->
        <activity
            android:name=".ScreensaverActivity"
            android:exported="true"
            android:launchMode="singleInstance"
            android:taskAffinity=".screensaver"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:screenOrientation="landscape"
            android:hardwareAccelerated="true"
            android:theme="@style/Theme.Glass"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection" />

        <!-- The pond as an app of its own in Fire TV's Your Apps, to start it at will -->
        <activity-alias
            android:name=".KoiPond"
            android:targetActivity=".ScreensaverActivity"
            android:exported="true"
            android:label="Koi Pond"
            android:icon="@drawable/banner_koi_pond"
            android:banner="@drawable/banner_koi_pond">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Notification access lets the Now Playing pill see other apps' media sessions -->
        <service
            android:name=".MediaListener"
            android:exported="true"
            android:label="@string/media_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Hears how an update install went (Updater.install) -->
        <receiver android:name=".Updater$InstallResult" android:exported="false" />

        <!-- Fire OS won't let the Amazon launcher be disabled: this redirects Home to Glass -->
        <service
            android:name=".HomeButtonService"
            android:exported="true"
            android:label="@string/a11y_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/home_button_service" />
        </service>
    </application>
</manifest>
