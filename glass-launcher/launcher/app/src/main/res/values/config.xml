<resources>
    <!-- Dock apps, left to right. Missing or disabled packages are skipped.
         Overridable without rebuilding: ./configure.sh dock pkg1 pkg2 pkg3 pkg4 -->
    <string-array name="dock_packages">
        <item>com.netflix.ninja</item>
        <item>com.amazon.firetv.youtube</item>
        <item>com.disney.disneyplus</item>
        <item>com.hulu.plus</item>
    </string-array>

    <!-- Never shown in the grid: Amazon system screens that register phone-style launcher
         entries, plus the stock launcher. Override without rebuilding:
         ./configure.sh hide pkg ... (adds to this list) -->
    <string-array name="hidden_packages">
        <item>com.amazon.tv.launcher</item>
        <item>com.amazon.audiohome</item>
        <item>com.amazon.firetv.troubleshooting</item>
        <item>com.amazon.ftv.profilepicker</item>
        <item>com.amazon.ftv.screensaver</item>
        <item>com.amazon.hedwig</item>
        <item>com.amazon.smarthomemapviewapp</item>
        <item>com.amazon.ssm</item>
        <item>com.amazon.whasettings</item>
    </string-array>

    <!-- AirPlay receiver apps (for iPhones; the stick has no AirPlay of its own). The first one
         installed is offered in the Cast tile's menu, and the screensaver stays off over it. -->
    <string-array name="airplay_packages">
        <item>com.ionitech.airscreen</item>
        <item>com.softmedia.receiver</item>
    </string-array>
</resources>
